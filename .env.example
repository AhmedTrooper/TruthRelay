# docker-compose env overrides.
# Copy to `.env` (gitignored) and edit for your environment.

# Comma-separated public origins allowed for the API's CORS layer.
TRUTHRELAY_ADMIN_TOKEN=dev-token-change-me

# Host port mapping. Internal service ports stay fixed:
#   api container  -> 8080
#   web container  -> 80  (served by internal nginx)
TRUTHRELAY_API_PORT=8080
TRUTHRELAY_WEB_PORT=5173

# Logging verbosity. One of trace,debug,info,warn,error.
RUST_LOG=info